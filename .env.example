# PostgreSQL
POSTGRES_DB=allugme
POSTGRES_USER=allugme
POSTGRES_PASSWORD=allugme_dev

ConnectionStrings__Default=Host=localhost;Port=5432;Database=allugme;Username=allugme;Password=allugme_dev
ConnectionStrings__PostgreSQL=Host=localhost;Port=5432;Database=allugme;Username=allugme;Password=allugme_dev

# Redis
ConnectionStrings__Redis=localhost:6379

# JWT
Jwt__SigningKey=DEV_ONLY_CHANGE_ME_Allugme_Jwt_Signing_Key_32+

# Seed (dev/demo)
Seed__Enabled=true
Seed__DemoData=true
Seed__DemoPassword=Demo@123456
Seed__SuperAdmin__Email=admin@allugme.com.br
Seed__SuperAdmin__Password=Admin123#

# Swagger
Swagger__Enabled=true

# Evolution API (WhatsApp)
Evolution__Enabled=false
Evolution__BaseUrl=http://localhost:8080
Evolution__ApiKey=change-me
Evolution__WebhookSecret=change-me-webhook-secret

# ASP.NET
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5080

# React (Vite) — local via nginx-local
VITE_API_URL=http://192.168.15.119/allugme/api/v1
VITE_API_BASE_URL=http://192.168.15.119/allugme/api/v1
VITE_BASE_PATH=/allugme/

# OCI (produção — usar no .env do servidor /var/www/allugme)
# VITE_API_URL=https://allugme.com.br/allugme/api/v1
# VITE_BASE_PATH=/allugme/
